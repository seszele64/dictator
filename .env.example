# ============================================
# Whisper API Configuration
# ============================================
# Set WHISPER_PROVIDER to choose your provider: openai, groq, together, deepinfra, openrouter, local, custom
# Then set the corresponding API key env var (or use WHISPER_API_KEY to override)

WHISPER_PROVIDER=openai
WHISPER_API_KEY=
WHISPER_BASE_URL=
# Blank means "use the provider default" (openai → whisper-1, groq →
# whisper-large-v3, openrouter → microsoft/mai-transcribe-2).
WHISPER_MODEL=
WHISPER_TIMEOUT=30
WHISPER_LANGUAGE=
WHISPER_TEMPERATURE=0
WHISPER_TASK=transcribe
# Pre-transcription silence detection threshold in dBFS (default: -50).
# Audio below this RMS level is skipped to prevent Whisper hallucinations.
# Note: detection cannot be disabled via env (that is code-only, None);
# use a very low threshold like -100 to effectively keep all audio.
# WHISPER_SILENCE_THRESHOLD_DBFS=-50

# ============================================
# Provider-specific API Keys (fallback)
# ============================================
# These are used automatically based on WHISPER_PROVIDER
# Only set the one matching your provider (or use WHISPER_API_KEY to override all)

OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=

# ============================================
# Provider Examples (uncomment ONE section)
# ============================================

# --- OpenAI ---
# WHISPER_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# WHISPER_MODEL=whisper-1

# --- Groq ---
# WHISPER_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# WHISPER_MODEL=whisper-large-v3

# --- Together AI ---
# WHISPER_PROVIDER=together
# TOGETHER_API_KEY=...
# WHISPER_MODEL=whisper-1

# --- OpenRouter ---
# WHISPER_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# WHISPER_MODEL=microsoft/mai-transcribe-2

# --- Local whisper.cpp / faster-whisper-server ---
# WHISPER_PROVIDER=local
# WHISPER_BASE_URL=http://localhost:8000/v1
# WHISPER_MODEL=base.en

# --- Custom OpenAI-compatible endpoint ---
# WHISPER_PROVIDER=custom
# WHISPER_API_KEY=sk-...   # optional: omit entirely if your endpoint needs no auth
# WHISPER_BASE_URL=https://your-api.example.com/v1
# WHISPER_MODEL=whisper-1

# ============================================
# Post-Processing (Chat) Configuration
# ============================================
# Separate from the WHISPER_* transcription block above. `whisper-dictate
# process` (Meta+P) sends the latest transcript to an OpenAI-compatible chat
# endpoint and stores the result on the same row.
#
# IMPORTANT: this block never inherits WHISPER_MODEL or any other WHISPER_*
# value. Chat models and transcription models are different: `whisper-1` is a
# transcription-only model and is invalid for chat completions, so
# POST_PROCESS_MODEL is required and has no default.
#
# POST_PROCESS_PROVIDER=openai          # openai, groq, together, deepinfra, openrouter, local, custom
# POST_PROCESS_MODEL=gpt-4o-mini        # REQUIRED: a chat model, e.g. gpt-4o-mini
# POST_PROCESS_BASE_URL=                # optional; provider default (required for `custom`)
# POST_PROCESS_API_KEY=                 # optional; falls back to the provider key env var
# POST_PROCESS_TIMEOUT=60               # seconds; default 60 (non-numeric/zero/negative -> 60)
# POST_PROCESS_PROMPT=                  # optional preset prompt (prefills rofi; headless fallback)

# ============================================
# Audio Configuration
# ============================================
# These are currently code defaults; add env var support if needed in the future
# (No audio env vars are currently read by the application)

# ============================================
# Other
# ============================================
# XDG data directory override (default: ~/.local/share)
# XDG_DATA_HOME=
#
# XDG state directory override for the log file (default: ~/.local/state)
# XDG_STATE_HOME=
#
# Note: there is no LOG_LEVEL env var — the application does not read one.
# Log level is controlled by the CLI flag: whisper-dictate --log-level DEBUG
